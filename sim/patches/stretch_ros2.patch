+    def _wait_for_joints(self, targets, tolerances, timeout):
+        """Block until every joint in `targets` has stopped within tolerance; return failure messages.
+
+        - A joint that stops without having moved since its last command is re-sent the command.
+        - A joint that stops outside tolerance is re-commanded with the remaining error added
+          (except the arm, see NO_CORRECTION). If the arm stops short, or a correction doesn't
+          move a joint, something is blocking it (e.g. the gripper against a cup): it fails,
+          and is commanded back to the plain target, so it pushes no harder than the unpatched
+          server did.
+        - The gripper is done once it stops: short of the target means it closed on an object
+          or reached its limit.
+        - Once all have stopped, every joint is checked again, because one that settled early
+          can sag after the others finish moving (e.g. the wrist pitch once the yaw stops).
+        """
+        sim = self.node.sim
+        status = sim.pull_status()
+        commanded = {a: target for a, (_, target) in targets.items()}
+        start_pos = {a: a.get_position(status) for a in targets}
+        corrections = dict.fromkeys(targets, 0)
+        resends = dict.fromkeys(targets, 0)
+        corrected = set()  # joints whose last command was a correction
+        still_since = {}
+        failures = {}
+        t_end = time.monotonic() + timeout
+
+        def tol_of(act):
+            return tolerances.get(targets[act][0], self.GOAL_TOLERANCE)
+
+        def command(act, pos):
+            sim.move_to(act, pos)
+            start_pos[act] = act.get_position(sim.pull_status())
+            still_since.pop(act, None)
+
+        def fail(act, msg):
+            failures[act] = msg
+            sim.move_to(act, targets[act][1])
+
+        def settle(pending):
+            while pending and time.monotonic() < t_end and sim.is_running():
+                time.sleep(0.02)
+                status = sim.pull_status()
+                now = time.monotonic()
+                for act in list(pending):
+                    joint, target = targets[act]
+                    pos = act.get_position(status)
+                    if abs(act.get_velocity(status)) > self.STILL_VEL:
+                        still_since.pop(act, None)
+                        continue
+                    if now - still_since.setdefault(act, now) < self.STILL_TIME_S:
+                        continue
+                    # The joint has stopped
+                    err = target - pos
+                    tol = tol_of(act)
+                    moved = abs(pos - start_pos[act]) >= self.MOVED
+                    if abs(err) <= tol / 2:  # aim for the middle so later sag stays inside tol
+                        pending.discard(act)
+                    elif not moved and act in corrected:  # a correction didn't move it: blocked
+                        if abs(err) > tol:
+                            fail(act, f"{joint} blocked at {pos:.4f}, target {target:.4f}")
+                        pending.discard(act)
+                    elif not moved and abs(err) > tol and resends[act] < self.MAX_RESENDS:
+                        resends[act] += 1  # the command may have been lost
+                        command(act, commanded[act])
+                    elif act == Actuators.gripper:
+                        pending.discard(act)
+                    elif act not in self.NO_CORRECTION and corrections[act] < self.MAX_CORRECTIONS:
+                        corrections[act] += 1
+                        corrected.add(act)
+                        commanded[act] = float(np.clip(commanded[act] + err,
+                                                       target - self.MAX_CORRECTION,
+                                                       target + self.MAX_CORRECTION))
+                        command(act, commanded[act])
+                    elif abs(err) <= tol:
+                        pending.discard(act)
+                    else:
+                        fail(act, f"{joint} blocked at {pos:.4f}, target {target:.4f}")
+                        pending.discard(act)
+            for act in pending:
+                joint, target = targets[act]
+                fail(act, f"{joint} did not reach {target:.4f} within {timeout:.0f} s")
+
+        settle(set(targets))
+        if targets:
+            time.sleep(self.STILL_TIME_S)
+            status = sim.pull_status()
+            drifted = {a for a in targets if a not in failures and a != Actuators.gripper
+                       and abs(targets[a][1] - a.get_position(status)) > tol_of(a) / 2}
+            settle(drifted)
+        return list(failures.values())
+
